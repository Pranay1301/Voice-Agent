# ============================================
# AI Voice Sales Agent - Environment Variables
# ============================================
# Copy this file to .env and fill in your values

# --- CALL SAFETY (DO NOT CHANGE IN PRODUCTION) ---
ALLOW_OUTBOUND_CALLS=false
REQUIRE_MANUAL_CALL_TRIGGER=true
TEST_MODE=true

# --- SERVER ---
PORT=3000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# --- TWILIO (Telephony) ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
# Public URL for Twilio webhooks (use ngrok for local dev)
TWILIO_WEBHOOK_BASE_URL=

# --- DEEPGRAM (ASR / Speech-to-Text) ---
DEEPGRAM_API_KEY=

# --- GROQ (LLM) ---
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_FALLBACK_MODEL=llama-3.1-8b-instant

# --- ELEVENLABS (TTS / Text-to-Speech) ---
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL=eleven_flash_v2_5

# --- WHATSAPP (Meta Cloud API) ---
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=

# --- EMAIL (SMTP) ---
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASS=
EMAIL_FROM=

# --- BUSINESS ---
MEETING_LINK=
TIMEZONE=Asia/Kolkata
COMPANY_NAME=ElevateBox Properties
AGENT_NAME=Priya

# --- DATABASE ---
DATABASE_PATH=./data/voice_agent.db

# --- COST PROTECTION ---
MAX_CALL_DURATION_SECONDS=600
MAX_LLM_TOKENS_PER_TURN=300
MAX_CALLS_PER_SESSION=10
MAX_ACTION_RETRIES=3
